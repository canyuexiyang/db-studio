{
  "name": "db-studio",
  "version": "0.4.0",
  "private": true,
  "description": "DB Studio - 反应最快的 macOS 数据库查看器",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck:core && npm run typecheck:renderer",
    "typecheck:core": "tsc --noEmit",
    "typecheck:renderer": "tsc --noEmit --project apps/desktop/renderer/tsconfig.json",
    "build:renderer": "vite build --config apps/desktop/renderer/vite.config.ts",
    "build:main": "vite build --config apps/desktop/vite.main.config.ts",
    "build:preload": "vite build --config apps/desktop/vite.preload.config.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload && node scripts/copy-workers.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "verify": "npm run typecheck && npm test && npm run check:bundle && npm run e2e && npm run e2e:transfer && npm run e2e:ssh && npm run e2e:grid && npm run e2e:ui && npm run e2e:app",
    "e2e": "tsx scripts/e2e-smoke.mjs",
    "e2e:transfer": "node scripts/e2e-transfer.mjs",
    "e2e:perf": "tsx scripts/e2e-perf.mjs",
    "e2e:ssh": "tsx scripts/e2e-ssh.mjs",
    "e2e:grid": "tsx scripts/e2e-perf-grid.mjs",
    "e2e:ui": "node scripts/e2e-ui.mjs",
    "e2e:app": "npm run build && tsx scripts/e2e-app.mjs",
    "e2e:transfer:ui": "tsx scripts/e2e-transfer-ui.mjs",
    "e2e:script:ui": "tsx scripts/e2e-script-ui.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "start": "npm run build && electron apps/desktop/dist/main/main.cjs",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:dir": "npm run build && node scripts/pack-dir.mjs",
    "spike:s1": "cd spike/s1-glass-grid && ./run.sh",
    "spike:s2": "node spike/s2-coldstart/run.mjs",
    "spike:s3": "cd spike/s3-xlsx-export && node run-all.mjs",
    "spike:s4": "cd spike/s4-package-sign && npx electron-builder --mac --arm64 --dir",
    "spike:s5:seed": "node spike/s5-fixture-ipc/seed/seed.mjs",
    "spike:s5:bench": "node spike/s5-fixture-ipc/bench-ipc.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-window-glass": "^1.0.0",
    "mysql2": "^3.24.4",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "ssh2": "^1.17.0"
  }
}
